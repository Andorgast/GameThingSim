--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: effd63a2d87d06a4384dbb7a56db579f, type: 3}
  m_Name: HallwayDialogue
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  RootNode:
    dialogueText: "well, since I can\u2019t doomscroll on social media, what should
      I do?"
    responses:
    - responseText: Check my phone
      nextNode:
        dialogueText: "You grab your phone from your pocket and check your notifications.
          You click on the most recent one, but the app fails to load. Oh, right.
          There\u2019s no wifi. "
        responses:
        - responseText: Try to call your mother
          nextNode:
            dialogueText: Did you not learn anything?
            responses:
            - responseText: Put the phone down
              nextNode:
                dialogueText: 
                responses: []
        - responseText: Put the phone down
          nextNode:
            dialogueText: Bruh
            responses: []
    - responseText: 'Go to the kitchen '
      nextNode:
        dialogueText: "You make your way to the kitchen. You\u2019re thinking about
          all of the food that is going to spoil. Your stomach growls, so you raid
          the fridge. "
        responses:
        - responseText: Eat everything that will spoil
          nextNode:
            dialogueText: 'You ate everything that will spoil. Your cottage cheese,
              your fish left-overs from yesterday, all of the pre-sliced deli meat
              and your great aunts birthday cake slice. You feel nauseous after inhaling
              everything in sight. '
            responses:
            - responseText: Yeah... No more eating for a while
              nextNode:
                dialogueText: 
                responses: []
        - responseText: Make breakfast
          nextNode:
            dialogueText: You grab milk from the fridge and make some cornflakes.
              You sit at the table and start munching on it.
            responses:
            - responseText: Continue
              nextNode:
                dialogueText: 
                responses: []
        - responseText: Leave for now
          nextNode:
            dialogueText: Leave for now
            responses: []
    - responseText: Go outside
      nextNode:
        dialogueText: 'You walk outside and decide on the spot what you want to do '
        responses:
        - responseText: Knock on your neighbours door
          nextNode:
            dialogueText: You decide to check in on your neighbour. Maybe their power
              is out too? You walk over to their front door.
            responses:
            - responseText: Knock
              nextNode:
                dialogueText: Knock Knock Knock. The door slowly creaks open. And
                  you see a familiar face, it's Gertrude.
                responses:
                - responseText: Continue
                  nextNode:
                    dialogueText: Continue
                    responses: []
            - responseText: Leave
              nextNode:
                dialogueText: 'You decided to not bother them for now. '
                responses:
                - responseText: Continue
                  nextNode:
                    dialogueText: 
                    responses: []
        - responseText: 'Go to your car '
          nextNode:
            dialogueText: "\u201CGuess I\u2019ll go grocery shopping\u201D Screen
              fades to black"
            responses:
            - responseText: Continue
              nextNode:
                dialogueText: 
                responses: []
        - responseText: Go back inside
          nextNode:
            dialogueText: You decide you've had enough fresh air for now.
            responses:
            - responseText: Continue
              nextNode:
                dialogueText: 
                responses: []
